import tkinter as tk
import random
from tkinter import messagebox
import time
import pyautogui

MAX_NUMBERS = 200

running = False
delay = 0
count = 1


def start_clicker():
    global running, delay
    clicks_per_second = int(entry.get())
    delay = 1 / clicks_per_second
    messagebox.showinfo("Info", "Autocliker start work!")
    running = True
    schedule_click()

def schedule_click():
    global count, running
    if running:
        pyautogui.click()
        print("Click-Click")
        count = count + 1
        time.sleep(delay)
        if count > MAX_NUMBERS:
            running = False
        schedule_click()


def show_info():
    messagebox.showinfo("Info", "Керування курсором!")

def on_click(event):
    colors = ["#FF5733", "#33FF57", "#3357FF", "#F0E68C", "#FF33A1"]
    root.config(bg=random.choice(colors))
    print(event)

root = tk.Tk()
root.title("Auto Clicker")

root.geometry("300x200")

root.configure(bg='lightblue')

label = tk.Label(root, text="Auto Clicker", font=("Arial", 18), bg='lightblue')
label.pack(pady=10)



click_label = tk.Label(root, text="Кліків на секунду:", font=("Arial", 12), bg='lightblue')
click_label.pack()

entry = tk.Entry(root, font=("Arial", 12))
entry.pack(pady=5)

button_frame = tk.Frame(root, bg='lightblue')
button_frame.pack(pady=10)

start_button = tk.Button(button_frame, text="Почати", font=("Arial", 12), bg='green', fg='white', command=start_clicker)
start_button.pack(side='left', padx=10)

exit_button = tk.Button(button_frame, text="Вийти", font=("Arial", 12), bg='red', fg='white', command=root.quit)
exit_button.pack(side='right', padx=10)

#label.bind_all("<Return>", on_click)
root.bind("<Return>", on_click)
#root.bind('i', show_info)


root.mainloop()
